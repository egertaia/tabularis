@@ -0,0 +1,21 @@
+use std::io::Write;
+
+#[tauri::command]
+pub fn bench_config() -> Option<(String, String)> {
+    let sql_path = std::env::var("TABULARIS_BENCH_SQL").ok()?;
+    let connection = std::env::var("TABULARIS_BENCH_CONNECTION").ok()?;
+    let sql = std::fs::read_to_string(sql_path).ok()?;
+    Some((sql, connection))
+}
+
+#[tauri::command]
+pub fn bench_emit(line: String) {
+    let mut out = std::io::stdout();
+    let _ = writeln!(out, "{line}");
+    let _ = out.flush();
+}
+
+#[tauri::command]
+pub fn bench_exit(code: i32) {
+    std::process::exit(code);
+}
