diff --git a/packages/web-ui/src/benchDriver.tsx b/packages/web-ui/src/benchDriver.tsx
new file mode 100644
index 00000000..757aee2c
--- /dev/null
+++ b/packages/web-ui/src/benchDriver.tsx
@@ -0,0 +1,97 @@
+import {useEffect, useRef} from 'react';
+import {useNavigate} from 'react-router-dom';
+import {invoke} from '@tauri-apps/api/core';
+import {useDatabase} from '@/hooks/useDatabase';
+
+type BenchResult = {
+    rows: unknown[];
+    truncated?: boolean;
+    pagination?: {has_more?: boolean} | null;
+};
+
+const MAX_SCROLL_FRAMES = 600;
+const SCROLL_STEP_PX = 2000;
+
+let armed = false;
+let t0: number | null = null;
+
+const emit = (line: string) => invoke('bench_emit', {line});
+const frame = () => new Promise<number>((resolve) => requestAnimationFrame(resolve));
+
+function percentile(sorted: number[], p: number): number {
+    return sorted[Math.max(0, Math.ceil((p / 100) * sorted.length) - 1)];
+}
+
+async function fail(error: unknown) {
+    await emit(`BENCH error=${String(error instanceof Error ? error.message : error)}`);
+    await invoke('bench_exit', {code: 1});
+}
+
+export function benchStart() {
+    if (armed && t0 === null) t0 = performance.now();
+}
+
+export function benchResult(res: BenchResult) {
+    if (!armed || t0 === null) return;
+    const start = t0;
+    const loadedAt = performance.now();
+    armed = false;
+    measure(start, loadedAt, res).catch(fail);
+}
+
+async function measure(
+    start: number,
+    loadedAt: number,
+    res: BenchResult,
+) {
+    let grid: HTMLElement | null = null;
+    while (!(grid = document.querySelector<HTMLElement>('[data-bench-grid]'))?.querySelector('td[data-row-index]')) {
+        await frame();
+    }
+    await frame();
+    await frame();
+    const paintedAt = performance.now();
+    await emit(`BENCH first_paint_ms=${(paintedAt - start).toFixed(1)}`);
+    await emit(
+        `BENCH all_loaded_ms=${res.truncated || res.pagination?.has_more ? 'na' : (loadedAt - start).toFixed(1)}`,
+    );
+    await emit(`BENCH rows=${res.rows.length}`);
+
+    const intervals: number[] = [];
+    let last = await frame();
+    for (let i = 0; i < MAX_SCROLL_FRAMES; i++) {
+        if (grid.scrollTop + grid.clientHeight >= grid.scrollHeight - 1) break;
+        grid.scrollTop += SCROLL_STEP_PX;
+        const now = await frame();
+        intervals.push(now - last);
+        last = now;
+    }
+    const sorted = [...intervals].sort((a, b) => a - b);
+    await emit(
+        `BENCH scroll_p50_ms=${percentile(sorted, 50).toFixed(2)} scroll_p99_ms=${percentile(sorted, 99).toFixed(2)} frames=${sorted.length}`,
+    );
+    await invoke('bench_exit', {code: 0});
+}
+
+export function BenchDriver() {
+    const {connect} = useDatabase();
+    const navigate = useNavigate();
+    const started = useRef(false);
+
+    useEffect(() => {
+        if (started.current) return;
+        started.current = true;
+        (async () => {
+            const config = await invoke<[string, string] | null>('bench_config');
+            if (!config) return;
+            const [sql, connectionId] = config;
+            armed = true;
+            await connect(connectionId);
+            navigate('/editor', {
+                state: {kind: 'console', initialQuery: sql, targetConnectionId: connectionId},
+            });
+        })().catch(fail);
+    }, [connect, navigate]);
+
+    return null;
+}
